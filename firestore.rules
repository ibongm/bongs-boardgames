rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function bootstrapAdmin() {
      return signedIn() && request.auth.token.email == 'ivanm.ploce@gmail.com';
    }
    function roomIdentityIntact() {
      return request.resource.data.hostId == resource.data.hostId
        && request.resource.data.code == resource.data.code
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.passwordHash == resource.data.passwordHash
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    function ownerUserSafe() {
      return isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.disabled == resource.data.disabled
        && request.resource.data.stats == resource.data.stats
        && request.resource.data.games == resource.data.games
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          request.resource.data.email == resource.data.email
          || request.resource.data.email == request.auth.token.email
        );
    }
    function ownerBootstrapRole() {
      return isOwner(userId)
        && bootstrapAdmin()
        && request.resource.data.role == 'admin'
        && request.resource.data.disabled == resource.data.disabled
        && request.resource.data.stats == resource.data.stats
        && request.resource.data.games == resource.data.games;
    }
    function matchIdentityFrozen() {
      return request.resource.data.gameId == resource.data.gameId
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.playerIds == resource.data.playerIds
        && request.resource.data.playerSeats == resource.data.playerSeats
        && request.resource.data.ratingSnapshot == resource.data.ratingSnapshot
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    function resultWriteOnce() {
      return resource.data.result == null
        || request.resource.data.result == resource.data.result;
    }
    function afterResultFlagsOnly() {
      return resource.data.result == null
        || (
          request.resource.data.state == resource.data.state
          && request.resource.data.seats == resource.data.seats
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.disabled == false
        && (
          request.resource.data.role == 'player'
          || (request.resource.data.role == 'admin' && bootstrapAdmin())
        );
      allow update: if isAdmin() || ownerUserSafe() || ownerBootstrapRole();
    }

    match /publicProfiles/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
        && (
          request.resource.data.role == 'player'
          || (request.resource.data.role == 'admin' && bootstrapAdmin())
        );
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.role == resource.data.role
        );
    }

    match /site/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stats/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /rooms/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.status == 'waiting'
        && request.resource.data.matchId == null;
      allow update: if signedIn() && roomIdentityIntact() && (
        isAdmin()
        || resource.data.hostId == request.auth.uid
        || request.auth.uid in resource.data.participantIds
        || (
          resource.data.status == 'waiting'
          && request.resource.data.status == 'waiting'
          && request.resource.data.matchId == resource.data.matchId
          && request.auth.uid in request.resource.data.participantIds
        )
      );
      allow delete: if signedIn() && (isAdmin() || resource.data.hostId == request.auth.uid);
    }

    match /matches/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.playerIds
        && request.resource.data.result == null
        && request.resource.data.roomId is string
        && request.resource.data.gameId is string;
      allow update: if signedIn()
        && request.auth.uid in resource.data.playerIds
        && matchIdentityFrozen()
        && resultWriteOnce()
        && afterResultFlagsOnly();
    }
  }
}
